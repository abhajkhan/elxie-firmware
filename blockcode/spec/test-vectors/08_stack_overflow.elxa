; 17 pushes overflow the 16-slot stack: must stop cleanly with STACK_OVERFLOW (1).
.name "Deep"
.script start
    push 1
    push 2
    push 3
    push 4
    push 5
    push 6
    push 7
    push 8
    push 9
    push 10
    push 11
    push 12
    push 13
    push 14
    push 15
    push 16
    push 17
